# Copy to .env and fill in. .env is git-ignored.

# Comma-separated API keys accepted in the X-API-Key header.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Allowed browser origins for the API (comma-separated)
CORS_ORIGINS=http://localhost:8501

# Requests per client per minute (per API process; 0 disables)
RATE_LIMIT_PER_MINUTE=60
